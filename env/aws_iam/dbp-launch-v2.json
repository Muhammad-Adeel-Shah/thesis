{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideUsEast2",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "DenyEverythingNotListed",
      "Effect": "Deny",
      "NotAction": [
        "ec2:Describe*",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ec2:RunInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:CreateVolume",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume",
        "ec2:CreateTags",
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup",
        "ec2:ImportKeyPair",
        "ec2:DeleteKeyPair",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyPaidExtrasAndResizes",
      "Effect": "Deny",
      "Action": [
        "s3:*",
        "ec2:AllocateAddress",
        "ec2:AssociateAddress",
        "ec2:CreateSnapshot",
        "ec2:CreateSnapshots",
        "ec2:CreateImage",
        "ec2:CreateNatGateway",
        "ec2:RequestSpotInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyVolume",
        "elasticloadbalancing:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyAnyInstanceTypeButG52xlargeOrG62xlarge",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotEquals": {
          "ec2:InstanceType": [
            "g5.2xlarge",
            "g6.2xlarge"
          ]
        }
      }
    },
    {
      "Sid": "DenyVolumesThatAreNotGp3",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateVolume",
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:volume/*",
      "Condition": {
        "StringNotEquals": {
          "ec2:VolumeType": "gp3"
        }
      }
    },
    {
      "Sid": "DenyVolumesOver200GB",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateVolume",
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:volume/*",
      "Condition": {
        "NumericGreaterThan": {
          "ec2:VolumeSize": "200"
        }
      }
    },
    {
      "Sid": "ReadForTheLaunch",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RunOnlyTheTaggedG52xlargeOrG62xlarge",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-2:*:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:InstanceType": [
            "g5.2xlarge",
            "g6.2xlarge"
          ],
          "aws:RequestTag/Name": "dbp-p5"
        }
      }
    },
    {
      "Sid": "RunInstancesSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-2::image/*",
        "arn:aws:ec2:us-east-2:*:subnet/*",
        "arn:aws:ec2:us-east-2:*:network-interface/*",
        "arn:aws:ec2:us-east-2:*:security-group/*",
        "arn:aws:ec2:us-east-2:*:key-pair/*",
        "arn:aws:ec2:us-east-2:*:volume/*"
      ]
    },
    {
      "Sid": "CreateOnlyTheTaggedDataVolume",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:aws:ec2:us-east-2:*:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Name": "dbp-p5-data"
        }
      }
    },
    {
      "Sid": "TagOnlyAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-2:*:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume"
          ]
        }
      }
    },
    {
      "Sid": "StartStopAttachAndTearDownOnlyTheP5Resources",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-2:*:instance/*",
        "arn:aws:ec2:us-east-2:*:volume/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/Name": "dbp-p5*"
        }
      }
    },
    {
      "Sid": "SshSecurityGroupAndKeyPair",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup",
        "ec2:ImportKeyPair",
        "ec2:DeleteKeyPair"
      ],
      "Resource": "*"
    }
  ]
}
